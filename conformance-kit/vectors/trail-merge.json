{
  "description": "Response-side trail merge: a callee's subtree appended under its caller's entry, re-indexed and bounded (R-P02, R-P03).",
  "cases": [
    {
      "name": "callee subtree under the caller",
      "base": "rv=1, inc=?0, h=\"2:0:900:F:3\"",
      "sub": "rv=1, inc=?0, h=\"3:0:400:F:5;4:1:100:F:6\"",
      "parent": 1,
      "expect": "rv=1, inc=?0, h=\"2:0:900:F:3;3:1:400:F:5;4:2:100:F:6\""
    },
    {
      "name": "second callee after the first",
      "base": "rv=1, inc=?0, h=\"2:0:900:F:3;3:1:400:F:5\"",
      "sub": "rv=1, inc=?0, h=\"4:0:300:F:5\"",
      "parent": 1,
      "expect": "rv=1, inc=?0, h=\"2:0:900:F:3;3:1:400:F:5;4:1:300:F:5\""
    },
    {
      "name": "incomplete subtree makes the result incomplete",
      "base": "rv=1, inc=?0, h=\"2:0:900:F:3\"",
      "sub": "rv=1, inc=?1, h=\"6:0:1200:U:4\"",
      "parent": 1,
      "expect": "rv=1, inc=?1, h=\"2:0:900:F:3;6:1:1200:U:4\""
    },
    {
      "name": "another registry version is not merged",
      "base": "rv=1, inc=?0, h=\"2:0:900:F:3\"",
      "sub": "rv=2, inc=?0, h=\"3:0:400:F:5\"",
      "parent": 1,
      "expect": "rv=1, inc=?1, h=\"2:0:900:F:3\""
    },
    {
      "name": "entries beyond 16 are dropped with their descendants",
      "base": "rv=1, inc=?0, h=\"1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0\"",
      "sub": "rv=1, inc=?0, h=\"3:0:400:F:5;4:1:100:F:6\"",
      "parent": 1,
      "expect": "rv=1, inc=?1, h=\"1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0;1:0:5:F:0\""
    },
    {
      "name": "appended as a new root",
      "base": "rv=1, inc=?0, h=\"2:0:900:F:3\"",
      "sub": "rv=1, inc=?0, h=\"3:0:400:F:5\"",
      "parent": 0,
      "expect": "rv=1, inc=?0, h=\"2:0:900:F:3;3:0:400:F:5\""
    }
  ]
}
